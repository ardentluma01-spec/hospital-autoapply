# Copy this file to .env and fill it in:   cp .env.example .env && nano .env
# NEVER share or upload your .env file — it holds your passwords.

# --- Dashboard login (you choose these) ---
DASHBOARD_USER=me
DASHBOARD_PASSWORD=change-this-to-something-long
SETUP_CODE=

# Public address of the dashboard, used for links in emails
# e.g. http://123.45.67.89:8000  (your server's IP)
PUBLIC_URL=http://YOUR-SERVER-IP:8000

# --- Claude API key (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Email notifications via Gmail ---
# Use a Gmail "App password", NOT your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
NOTIFY_TO=you@gmail.com

# --- Hospital careers logins: OPTIONAL ---
# Easier: enter them in the dashboard under "Hospital logins" (stored encrypted).
# Anything filled in here is only used as a fallback.
WESTERN_EMAIL=
WESTERN_PASSWORD=
EASTERN_EMAIL=
EASTERN_PASSWORD=
RCH_EMAIL=
RCH_PASSWORD=
MONASH_EMAIL=
MONASH_PASSWORD=
PETERMAC_EMAIL=
PETERMAC_PASSWORD=
NORTHERN_EMAIL=
NORTHERN_PASSWORD=
SVHM_EMAIL=
SVHM_PASSWORD=
